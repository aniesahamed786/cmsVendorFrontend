# Render build: the Angular app served by nginx, on public images — Render cannot pull from
# Aramco's private Artifact Registry. The GCP pipeline keeps using Dockerfile /
# Dockerfile.chainguard. API calls go straight to the Render backend
# (src/environments/environment.render.ts), so nginx here only serves files.

# ---------- Stage 1: Build Angular ----------
FROM node:20 AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
# production optimisations, plus src/environments/environment.render.ts
RUN npx ng build --configuration production,render


# ---------- Stage 2: nginx ----------
FROM nginx:1.27-alpine

# Render sets PORT at runtime; this default only applies when the image runs elsewhere.
ENV PORT=8080

RUN rm /etc/nginx/conf.d/default.conf
# The image's entrypoint renders /etc/nginx/templates/*.template into conf.d at start-up.
COPY nginx.render.conf.template /etc/nginx/templates/default.conf.template
COPY --from=builder /app/dist/cms-vendor-frontend/browser /usr/share/nginx/html
